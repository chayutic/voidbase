# Copy to .env and fill in. .env is gitignored; this file is committed.

# IsThereAnyDeal — https://isthereanydeal.com/dev/app/
ITAD_KEY=

# Jellyfin — API key from Jellyfin Dashboard → API Keys
JELLYFIN_URL=http://192.168.1.41:8096
JELLYFIN_KEY=

# World Air Quality Index — https://aqicn.org/data-platform/token/
AQ_TOKEN=
AQ_CITY=Bangkok

# Notes storage — host path bind-mounted to /app/notes by compose.
# Put this on redundant storage, not the app volume.
NOTES_HOST_DIR=/home/chayutic/data/voidbase/notes

# Gates /notes* behind HTTP Basic Auth (any username, this password).
# Required: left blank, /notes* answers 503 and all access is blocked.
NOTES_PASSWORD=
